# ---------------------------------------------------------------------------
# Secrets & environment overrides.  Copy to ".env" and fill in.
# Everything here is OPTIONAL - the tool runs without notifications.
# ---------------------------------------------------------------------------

# Database. Leave unset for local SQLite (data/prices.db).
# For the Hetzner box with Postgres already running, e.g.:
# DATABASE_URL=postgresql+psycopg://tracker:secret@localhost:5432/urlaub_tracker
# DATABASE_URL=

# --- E-mail alerts (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=urlaub-tracker@example.com
SMTP_STARTTLS=true
# comma separated
ALERT_EMAIL_TO=

# --- Push alerts (ntfy.sh - self-hostable, no account needed) ---
# Topic is a shared secret; pick something unguessable.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Optional bearer/basic token for a protected ntfy server
NTFY_TOKEN=

# --- Optional: protect POST /api/check/run ---
TRIGGER_TOKEN=

# --- Optional proxy for the flight scraper (helps avoid Google blocks) ---
# FLIGHTS_PROXY=http://user:pass@host:port
